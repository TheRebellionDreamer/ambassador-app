NODE_ENV=development
PORT=3000

# docker compose up -d postgres
DATABASE_URL=postgresql://ambassador:ambassador@localhost:5432/ambassador
DATABASE_URL_TEST=postgresql://ambassador:ambassador@localhost:5432/ambassador_test

# Сгенерировать: openssl rand -base64 48
JWT_ACCESS_SECRET=change-me-access-secret-at-least-32-chars
JWT_ACCESS_TTL=15m
JWT_REFRESH_SECRET=change-me-refresh-secret-at-least-32-chars
JWT_REFRESH_TTL_DAYS=30

# Через запятую
CORS_ORIGIN=http://localhost:5173
